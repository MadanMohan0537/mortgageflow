# Application
APP_NAME=MortgageFlow
APP_ENV=local
API_PREFIX=/v1
LOG_LEVEL=INFO
CORRELATION_HEADER=X-Correlation-ID

# Security (change in every environment)
API_KEY=dev-api-key-change-me
JWT_SECRET=dev-jwt-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql+psycopg2://mortgageflow:mortgageflow@localhost:5432/mortgageflow

# Validation rules (demo thresholds only)
DTI_REVIEW_THRESHOLD=43.00
RULES_VERSION=demo-rules-v1

# AWS / S3 (localstack-compatible for local)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=mortgageflow-docs-local
S3_ENDPOINT_URL=http://localhost:4566
PRESIGNED_URL_EXPIRES_SECONDS=300
MAX_DOCUMENT_BYTES=1048576
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.txt
